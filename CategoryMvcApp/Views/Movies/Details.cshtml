@model MovieDetailViewModel

@{
    ViewData["Title"] = Model?.Title ?? "Movie Details";
}

<div class="container py-5">
    @if (Model != null)
    {
        <div class="row mb-5">
            <!-- Movie Poster & Basic Info -->
            <div class="col-lg-4 mb-4">
                <div class="card shadow-sm">
                    @if (!string.IsNullOrEmpty(Model.PosterUrl))
                    {
                        <img src="@Model.PosterUrl" alt="@Model.Title" class="card-img-top" style="object-fit: cover; height: 400px;">
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
                            <span class="text-muted">No Image</span>
                        </div>
                    }

                    <div class="card-body">
                        <h5 class="card-title">@Model.Title</h5>

                        <div class="mb-3">
                            <span class="badge bg-primary me-2">
                                <i class="bi bi-clock"></i> @Model.DurationMinutes mins
                            </span>
                            @if (Model.ReleaseDate != null)
                            {
                                <span class="badge bg-info">
                                    <i class="bi bi-calendar"></i> @Model.ReleaseDate.Value.ToString("MMM yyyy")
                                </span>
                            }
                        </div>

                        <p class="text-muted small">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </p>

                        @if (!string.IsNullOrEmpty(Model.TrailerUrl))
                        {
                            <a href="@Model.TrailerUrl" target="_blank" class="btn btn-outline-primary btn-sm w-100">
                                <i class="bi bi-play-circle"></i> Watch Trailer
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Movie Description & Showtimes -->
            <div class="col-lg-8">
                <!-- Description -->
                <div class="mb-5">
                    <h3>About the Movie</h3>
                    <p class="lead">@Model.Description</p>
                </div>

                <!-- Available Showtimes -->
                <div>
                    <h3 class="mb-4">🕐 Available Showtimes</h3>

                    @if (Model.ShowTimes != null && Model.ShowTimes.Any())
                    {
                        <div class="row g-3">
                            @foreach (var show in Model.ShowTimes)
                            {
                                <div class="col-md-6">
                                    <div class="card showtime-card border-0 shadow-sm hover-lift h-100">
                                        <div class="card-body">
                                            <!-- Theatre & Screen Info -->
                                            <h6 class="card-subtitle mb-2 text-muted">
                                                <i class="bi bi-building"></i> @show.TheatreName
                                            </h6>
                                            <p class="card-text small text-muted">
                                                Screen @show.ScreenName | @show.City
                                            </p>

                                            <!-- Date & Time -->
                                            <h5 class="card-title mb-2">
                                                <i class="bi bi-calendar-event"></i> @show.StartDateTime.ToString("ddd, MMM dd")
                                            </h5>
                                            <p class="card-text display-6 text-primary fw-bold mb-3">
                                                @show.StartDateTime.ToString("h:mm tt")
                                            </p>

                                            <!-- Price Range -->
                                            <div class="mb-3">
                                                <span class="badge bg-success bg-opacity-75 fs-6">
                                                    @show.PriceRange
                                                </span>
                                            </div>

                                            <!-- Book Button -->
                                            <a href="@Url.Action("SelectSeats", "Booking", new { showId = show.ShowId })" 
                                               class="btn btn-primary w-100">
                                                <i class="bi bi-ticket-perforated"></i> Book Tickets
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> No upcoming showtimes available for this movie.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Back Button -->
        <div class="row">
            <div class="col-12">
                <a href="@Url.Action("Index", "Movies")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Movies
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            Movie not found.
        </div>
    }
</div>

<style>
    .showtime-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 0.5rem;
    }

    .showtime-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15) !important;
    }

    .hover-lift {
        border-radius: 0.5rem;
    }
</style>
