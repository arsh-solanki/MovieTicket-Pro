@model List<MovieCardViewModel>

@{
    ViewData["Title"] = "All Movies";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-lg-12">
            <h1 class="mb-2">🎬 All Movies</h1>
            <p class="text-muted">Browse available movies and book your tickets</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var movie in Model)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="card movie-card h-100 shadow-sm hover-lift">
                        <!-- Movie Poster -->
                        <div class="position-relative overflow-hidden" style="height: 350px;">
                            @if (!string.IsNullOrEmpty(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl" alt="@movie.Title" class="card-img-top" style="object-fit: cover; height: 100%;">
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center h-100">
                                    <span class="text-muted">No Image</span>
                                </div>
                            }
                        </div>

                        <!-- Movie Info -->
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-2">@movie.Title</h5>
                            <p class="card-text text-muted small mb-3">
                                @if (movie.ReleaseDate != null)
                                {
                                    <span>Released: @movie.ReleaseDate.Value.ToString("MMM dd, yyyy")</span>
                                }
                            </p>

                            @if (!string.IsNullOrEmpty(movie.Description))
                            {
                                <p class="card-text small flex-grow-1">
                                    @Html.Raw(movie.Description)
                                </p>
                            }

                            <hr class="my-2">

                            <!-- Action Buttons -->
                            <div class="btn-group-vertical gap-2 mt-auto">
                                <a href="@Url.Action("Details", "Movies", new { id = movie.Id })" class="btn btn-primary btn-sm">
                                    <i class="bi bi-ticket"></i> View Showtimes
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">No movies available</h4>
            <p>There are currently no movies available for booking. Please check back later.</p>
        </div>
    }
</div>

<style>
    .movie-card {
        border: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .movie-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15) !important;
    }

    .hover-lift {
        border-radius: 0.5rem;
    }
</style>
