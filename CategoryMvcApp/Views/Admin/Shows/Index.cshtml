@model IEnumerable<CategoryMvcApp.Models.Show>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-calendar3 me-2"></i>Shows Management</h2>
        <a href="/Admin/Shows/Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Add Show</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Movie Title</th>
                            <th>Screen Name</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td><strong>@s.Movie?.Title</strong></td>
                                    <td>@s.Screen?.Name</td>
                                    <td>@s.StartDateTime.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@s.EndDateTime.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@s.Price.ToString("C")</td>
                                    <td>
                                        @if (s.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Admin/Shows/Edit/@s.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i>Edit</a>
                                        <form method="post" action="/Admin/Shows/Delete/@s.Id" class="d-inline" onsubmit="return confirm('Delete this show?');">
                                            <input name="__RequestVerificationToken" type="hidden" value="@Antiforgery.GetTokens(HttpContext).RequestToken" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">No shows found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
