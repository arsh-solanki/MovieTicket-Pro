@model CategoryMvcApp.Models.Show
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isEdit = Model != null && Model.Id > 0;
    var movies = ViewBag.Movies as List<CategoryMvcApp.Models.Movie> ?? new List<CategoryMvcApp.Models.Movie>();
    var screens = ViewBag.Screens as List<CategoryMvcApp.Models.Screen> ?? new List<CategoryMvcApp.Models.Screen>();
}
<div class="container py-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2><i class="bi me-2"></i>@(isEdit ? "Edit Show" : "Create New Show")</h2>
            
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <form method="post" class="mt-3">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Movie <span class="text-danger">*</span></label>
                                <select asp-for="MovieId" class="form-select">
                                    <option value="">-- Select Movie --</option>
                                    @foreach (var m in movies)
                                    {
                                        <option value="@m.Id" @(Model.MovieId == m.Id ? "selected" : "")>@m.Title</option>
                                    }
                                </select>
                                <span asp-validation-for="MovieId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Screen <span class="text-danger">*</span></label>
                                <select asp-for="ScreenId" class="form-select">
                                    <option value="">-- Select Screen --</option>
                                    @foreach (var sc in screens)
                                    {
                                        <option value="@sc.Id" @(Model.ScreenId == sc.Id ? "selected" : "")>@sc.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="ScreenId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Start Date & Time <span class="text-danger">*</span></label>
                                <input asp-for="StartDateTime" class="form-control" type="datetime-local" />
                                <span asp-validation-for="StartDateTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">End Date & Time <span class="text-danger">*</span></label>
                                <input asp-for="EndDateTime" class="form-control" type="datetime-local" />
                                <span asp-validation-for="EndDateTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Price <span class="text-danger">*</span></label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="250.00" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label class="form-check-label">Active</label>
                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-2"></i>@(isEdit ? "Save Changes" : "Create Show")</button>
                            <a href="/Admin/Shows" class="btn btn-secondary"><i class="bi bi-x-circle me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
