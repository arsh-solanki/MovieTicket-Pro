@model CategoryMvcApp.Models.Screen
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isEdit = Model != null && Model.Id > 0;
    var theatres = ViewBag.Theatres as List<CategoryMvcApp.Models.Theatre> ?? new List<CategoryMvcApp.Models.Theatre>();
}
<div class="container py-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2><i class="bi me-2"></i>@(isEdit ? "Edit Screen" : "Create New Screen")</h2>
            
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <form method="post" class="mt-3">
                        <div class="mb-3">
                            <label class="form-label">Screen Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g., IMAX Screen 1" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Theatre <span class="text-danger">*</span></label>
                            <select asp-for="TheatreId" class="form-select">
                                <option value="">-- Select Theatre --</option>
                                @foreach (var t in theatres)
                                {
                                    <option value="@t.Id" @(Model.TheatreId == t.Id ? "selected" : "")>@t.Name</option>
                                }
                            </select>
                            <span asp-validation-for="TheatreId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Total Rows</label>
                                <input asp-for="TotalRows" class="form-control" type="number" placeholder="10" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Seats Per Row</label>
                                <input asp-for="SeatsPerRow" class="form-control" type="number" placeholder="15" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Screen Type</label>
                            <input asp-for="ScreenType" class="form-control" placeholder="e.g., IMAX, Dolby, Standard" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Seat Layout JSON</label>
                            <textarea asp-for="SeatLayoutJson" class="form-control" rows="4" placeholder="JSON layout (optional)"></textarea>
                            <div class="form-text">Provide seat layout JSON used by the customer seat selection UI.</div>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label class="form-check-label">Active</label>
                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-2"></i>@(isEdit ? "Save Changes" : "Create Screen")</button>
                            <a href="/Admin/Screens" class="btn btn-secondary"><i class="bi bi-x-circle me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
