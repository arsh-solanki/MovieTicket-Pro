@model IEnumerable<CategoryMvcApp.Models.Screen>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-door-closed me-2"></i>Screens Management</h2>
        <a href="/Admin/Screens/Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Add Screen</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Screen Name</th>
                            <th>Theatre Name</th>
                            <th>Total Seats</th>
                            <th>Screen Type</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td><strong>@s.Name</strong></td>
                                    <td>@s.Theatre?.Name</td>
                                    <td>@(s.TotalRows * s.SeatsPerRow) seats</td>
                                    <td>@s.ScreenType</td>
                                    <td>
                                        @if (s.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Admin/Screens/Edit/@s.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i>Edit</a>
                                        <form method="post" action="/Admin/Screens/Delete/@s.Id" class="d-inline" onsubmit="return confirm('Delete this screen?');">
                                            <input name="__RequestVerificationToken" type="hidden" value="@Antiforgery.GetTokens(HttpContext).RequestToken" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">No screens found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
