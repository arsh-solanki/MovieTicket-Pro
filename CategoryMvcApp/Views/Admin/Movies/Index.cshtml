@model IEnumerable<CategoryMvcApp.Models.Movie>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-film me-2"></i>Movies Management</h2>
        <a href="/Admin/Movies/Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Add Movie</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Title</th>
                            <th>Genre</th>
                            <th>Duration</th>
                            <th>Language</th>
                            <th>Release Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var movie in Model)
                            {
                                <tr>
                                    <td><strong>@movie.Title</strong></td>
                                    <td>@movie.Genre</td>
                                    <td>@movie.DurationMinutes mins</td>
                                    <td>@movie.Language</td>
                                    <td>@movie.ReleaseDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (movie.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Admin/Movies/Edit/@movie.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i>Edit</a>
                                        <form method="post" action="/Admin/Movies/Delete/@movie.Id" class="d-inline" onsubmit="return confirm('Delete this movie?');">
                                            <input name="__RequestVerificationToken" type="hidden" value="@Antiforgery.GetTokens(HttpContext).RequestToken" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">No movies found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
