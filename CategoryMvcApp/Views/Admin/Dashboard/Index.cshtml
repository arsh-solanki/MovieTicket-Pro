@model CategoryMvcApp.Models.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-4">
    <h2 class="mb-4">Admin Dashboard</h2>

    <!-- Today's Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-bg-primary shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3 display-6 text-white"><i class="bi bi-film"></i></div>
                    <div>
                        <h6 class="card-title">Movies</h6>
                        <h3>@Model.TotalMovies</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-success shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3 display-6 text-white"><i class="bi bi-calendar3"></i></div>
                    <div>
                        <h6 class="card-title">Shows Today</h6>
                        <h3>@Model.TotalShowsToday</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-warning shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3 display-6 text-white"><i class="bi bi-ticket-perforated"></i></div>
                    <div>
                        <h6 class="card-title">Bookings Today</h6>
                        <h3>@Model.TotalBookingsToday</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-danger shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3 display-6 text-white"><i class="bi bi-currency-dollar"></i></div>
                    <div>
                        <h6 class="card-title">Revenue Today</h6>
                        <h3>@Model.TotalRevenueToday.ToString("C")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- All-Time Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3 display-6 text-info"><i class="bi bi-graph-up"></i></div>
                    <div>
                        <h6 class="card-title">Total Bookings (All Time)</h6>
                        <h3>@Model.TotalBookingsAllTime</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3 display-6 text-success"><i class="bi bi-cash-coin"></i></div>
                    <div>
                        <h6 class="card-title">Total Revenue (All Time)</h6>
                        <h3>@Model.TotalRevenueAllTime.ToString("C")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Bookings Table -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recent Bookings (Last 10)</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Booking ID</th>
                            <th>User Email</th>
                            <th>Movie Title</th>
                            <th>Show Date/Time</th>
                            <th>Seats</th>
                            <th>Amount</th>
                            <th>Booked On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBookings.Any())
                        {
                            @foreach (var b in Model.RecentBookings)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@b.Id</span></td>
                                    <td>@b.UserEmail</td>
                                    <td>@b.Show?.Movie?.Title</td>
                                    <td>@b.Show?.StartDateTime.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@b.SeatCount</td>
                                    <td><strong>@b.TotalAmount.ToString("C")</strong></td>
                                    <td>@b.CreatedOn.ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">No recent bookings</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 7-Day Sales Summary Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>7-Day Sales Summary</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Booking Count</th>
                            <th>Total Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DailySales.Any())
                        {
                            @foreach (var day in Model.DailySales)
                            {
                                <tr>
                                    <td><strong>@day.Date</strong></td>
                                    <td>@day.BookingCount</td>
                                    <td><strong>@day.TotalRevenue.ToString("C")</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">No sales data available</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
