@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">
                <i class="fas fa-tachometer-alt"></i> Admin Dashboard
            </h1>
            <p class="lead text-muted">Welcome to the Movie Ticket Management System Administration Panel</p>
            <hr />
        </div>
    </div>

    <!-- Dashboard Quick Links -->
    <div class="row">
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-film fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Movies</h5>
                    <p class="card-text text-muted small">Manage movie catalog</p>
                </div>
                <div class="card-footer bg-white border-top-0">
                    <a href="/Admin/Movies" class="btn btn-sm btn-primary w-100">
                        <i class="fas fa-arrow-right"></i> Go to Movies
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-building fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Theatres</h5>
                    <p class="card-text text-muted small">Manage cinema venues</p>
                </div>
                <div class="card-footer bg-white border-top-0">
                    <a href="/Admin/Theatres" class="btn btn-sm btn-success w-100">
                        <i class="fas fa-arrow-right"></i> Go to Theatres
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-calendar-alt fa-3x text-info mb-3"></i>
                    <h5 class="card-title">Shows</h5>
                    <p class="card-text text-muted small">Manage show timings</p>
                </div>
                <div class="card-footer bg-white border-top-0">
                    <a href="/Admin/Shows" class="btn btn-sm btn-info w-100">
                        <i class="fas fa-arrow-right"></i> Go to Shows
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-ticket-alt fa-3x text-warning mb-3"></i>
                    <h5 class="card-title">Bookings</h5>
                    <p class="card-text text-muted small">View ticket bookings</p>
                </div>
                <div class="card-footer bg-white border-top-0">
                    <a href="/Admin/Bookings" class="btn btn-sm btn-warning w-100">
                        <i class="fas fa-arrow-right"></i> Go to Bookings
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Statistics (Future) -->
    <div class="row mt-5">
        <div class="col-md-12">
            <h3 class="mb-4">Summary Statistics</h3>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Total Bookings</h6>
                    <h2 class="text-primary mb-0"><!-- Count: @Model.TotalBookings --></h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Active Shows</h6>
                    <h2 class="text-success mb-0"><!-- Count: @Model.ActiveShows --></h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Registered Users</h6>
                    <h2 class="text-info mb-0"><!-- Count: @Model.UserCount --></h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Total Revenue</h6>
                    <h2 class="text-warning mb-0"><!-- Amount: @Model.TotalRevenue --></h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Section -->
    <div class="row mt-5">
        <div class="col-md-12">
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <strong><i class="fas fa-info-circle"></i> Getting Started</strong>
                <p class="mb-0 mt-2">
                    Use the quick links above to manage movies, theatres, screens, and shows.
                    View all bookings and generate reports from the respective sections.
                </p>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: all 0.3s ease-in-out;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .card-body i {
        opacity: 0.8;
    }
</style>
